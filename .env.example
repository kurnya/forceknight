# === 1-Core Server Optimization ===
# Max concurrent media jobs (FFmpeg/Sharp). Set 1 for single-core servers
# to prevent CPU saturation. Increase to 2+ only if you have multiple cores.
MEDIA_MAX_CONCURRENT=1

# Max queued media jobs waiting for a slot. Requests beyond this are rejected.
MEDIA_QUEUE_LIMIT=5

# Timeout (ms) for a single FFmpeg operation before it's force-killed.
# 120000 = 2 minutes. Increase for very long audio downloads.
FFMPEG_TIMEOUT_MS=120000

# Sharp (image processing) thread pool size. Set 1 for single-core servers.
SHARP_CONCURRENCY=1
