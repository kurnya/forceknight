BOT_NAME=Fuuka
BOT_NUMBER=6281234567890
PORT=3000
PREFIX=!
ALLOWED_GROUPS=120363412345678901@g.us,120363499999999@g.us
ENABLED_COMMANDS=fuuka,stiker,gambar,intro
GROUP_COMMAND_RULES=120363400608920219@g.us=stiker,gambar,intro
WHATSAPP_KEEP_ALIVE_MS=10000
WHATSAPP_CONNECT_TIMEOUT_MS=60000
WHATSAPP_DEFAULT_QUERY_TIMEOUT_MS=60000

# === AI Configuration ===
# Get free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SambaNova AI (primary) — free tier at https://cloud.sambanova.ai
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Cerebras AI (fallback) — free tier at https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# Groq (fallback) — free tier at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# === 1-Core Server Optimization ===
# Max concurrent media jobs (Sharp). Set 1 for single-core servers
# to prevent CPU saturation. Increase to 2+ only if you have multiple cores.
MEDIA_MAX_CONCURRENT=1

# Max queued media jobs waiting for a slot. Requests beyond this are rejected.
MEDIA_QUEUE_LIMIT=5

# Sharp (image processing) thread pool size. Set 1 for single-core servers.
SHARP_CONCURRENCY=1

# Ukuran maksimal media (byte) yang boleh diunduh untuk stiker/gambar. Default 15 MB.
MEDIA_MAX_BYTES=15728640

# Jeda minimal (ms) antar command media per pengirim, agar satu user tidak memenuhi antrean.
MEDIA_USER_COOLDOWN_MS=10000
