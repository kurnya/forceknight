BOT_NAME=Fuuka
BOT_NUMBER=6281234567890
PORT=3000
# URL halaman QR browser; isi URL publik jika bot berjalan di server.
# QR_BROWSER_URL=http://localhost:3000/qr
PREFIX=!
ALLOWED_GROUPS=120363412345678901@g.us,120363499999999@g.us
ENABLED_COMMANDS=fuuka,stiker,gambar,intro
GROUP_COMMAND_RULES=120363400608920219@g.us=stiker,gambar,intro
WHATSAPP_KEEP_ALIVE_MS=10000
WHATSAPP_CONNECT_TIMEOUT_MS=60000
WHATSAPP_DEFAULT_QUERY_TIMEOUT_MS=60000

# === AI Configuration ===
# Bot mendukung provider OpenAI-compatible dan Gemini native. Bot mencoba provider sesuai urutan,
# dan otomatis pindah ke key/provider berikutnya kalau kena limit (429), error, atau timeout.
#
# Banyak key untuk satu provider: pisahkan dengan koma, ATAU pakai nomor (_2, _3, ...).
#   GROQ_API_KEY=gsk_aaa,gsk_bbb      atau      GROQ_API_KEY=gsk_aaa
#                                              GROQ_API_KEY_2=gsk_bbb
# Key dipakai bergiliran. Kalau kena limit (429), key diistirahatkan:
# 1 menit untuk limit per menit, 6 jam untuk kuota harian.
#
# Beberapa model juga bisa dipisah koma: model kedua dipakai bila semua key habis
# untuk model pertama (tiap model punya kuota sendiri).
#
# Cek semua key & model: npm run cek-ai
#
# Urutan prioritas (opsional). Kalau kosong: sambanova,cerebras,groq,gemini,openrouter,mistral,together
# Groq Qwen sebagai utama, Gemini sebagai fallback:
AI_PROVIDERS=groq,gemini

# SambaNova — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Model: qwen/qwen3.8-27b
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_REASONING_EFFORT=none
# Model reasoning (gpt-oss) otomatis dikirim dengan reasoning_effort=low supaya balasan tidak kosong.
# Ubah lewat <NAMA>_REASONING_EFFORT=low|medium|high, atau "off" untuk mematikan.

# Gemini — https://aistudio.google.com/apikey
# Memakai API native Gemini. Flash-Lite dicoba lebih dulu untuk chat singkat.
# PENTING: kuota gratis Gemini dihitung per PROJECT, bukan per key. Key cadangan harus dibuat
# di project berbeda (AI Studio > Create API key > "Create API key in new project").
# GEMINI_API_KEY=AIza...
# GEMINI_API_KEY_2=AIza...
# Default model (bila dikosongkan): gemini-3.5-flash-lite,gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
# Jika model di akun Anda berbeda, isi GEMINI_MODEL dengan ID dari dokumentasi Gemini.

# Provider tambahan — WAJIB isi _MODEL sesuai model yang tersedia di akun Anda
# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Mistral — https://console.mistral.ai
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# Together — https://api.together.xyz
# TOGETHER_API_KEY=
# TOGETHER_MODEL=

# Provider lain (OpenAI-compatible) — pilih nama bebas, lalu masukkan ke AI_PROVIDERS. Contoh "deepinfra":
# AI_PROVIDERS=groq,deepinfra
# DEEPINFRA_URL=https://api.deepinfra.com/v1/openai/chat/completions
# DEEPINFRA_API_KEY=
# DEEPINFRA_MODEL=

# === 1-Core Server Optimization ===
# Max concurrent media jobs (Sharp). Set 1 for single-core servers
# to prevent CPU saturation. Increase to 2+ only if you have multiple cores.
MEDIA_MAX_CONCURRENT=1

# Max queued media jobs waiting for a slot. Requests beyond this are rejected.
MEDIA_QUEUE_LIMIT=5

# Sharp (image processing) thread pool size. Set 1 for single-core servers.
SHARP_CONCURRENCY=1

# Ukuran maksimal media (byte) yang boleh diunduh untuk stiker/gambar. Default 15 MB.
MEDIA_MAX_BYTES=15728640

# Jeda minimal (ms) antar command media per pengirim, agar satu user tidak memenuhi antrean.
MEDIA_USER_COOLDOWN_MS=10000
